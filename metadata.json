            {notificationState.name}{" "}
            <span className="text-[10px] md:text-xs font-normal text-gray-500 ml-1">
              {notificationState.city}
            </span>
          </p>
          <p className="text-[11px] md:text-xs text-gray-600 truncate mt-0.5">
            acabou de adquirir o <span className="font-extrabold text-blue-600">{notificationState.plan}</span>
          </p>
          <p className="text-[9px] md:text-[10px] text-gray-400 mt-1 flex items-center gap-1.5 font-bold tracking-wide uppercase">
            <span className="w-1.5 h-1.5 bg-green-500 rounded-full animate-ping" />
            <span>{notificationState.time}</span>
          </p>
        </div>
      </div>

    </div>
  );
}
