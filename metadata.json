    const startTimeout = setTimeout(() => {
      triggerNotification();
    }, 300);

    // Show periodic notifications every 15 seconds
    const interval = setInterval(() => {
      triggerNotification();
    }, 15000);

    return () => {
      clearTimeout(startTimeout);
      clearInterval(interval);
    };
  }, []);

