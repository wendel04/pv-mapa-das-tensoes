    const currentIndex = buyerIndexRef.current;
    if (!defaultBuyers[currentIndex]) return;

    const currentBuyer = defaultBuyers[currentIndex];
    const nextIndex = (currentIndex + 1) % defaultBuyers.length;
    buyerIndexRef.current = nextIndex;

    const randomMinutes = Math.floor(Math.random() * 59) + 1;
    const timeLabel = Math.random() > 0.7 ? "Agora mesmo" : `Há ${randomMinutes} min`;

